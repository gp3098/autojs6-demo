{
  "name": "autojs6-demo",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "babel src --extensions \".ts,.tsx\" --out-dir dist",
    "build:rhino": "babel src --extensions \".ts,.tsx\" --out-dir dist --config-file ./babel.config.rhino.js",
    "build:simple": "babel src --extensions \".ts,.tsx\" --out-dir dist --config-file ./babel.config.simple.js",
    "build:watch": "babel src --extensions \".ts,.tsx\" --out-dir dist --watch",
    "build:watch:rhino": "babel src --extensions \".ts,.tsx\" --out-dir dist --watch --config-file ./babel.config.rhino.js",
    "webpack:build": "webpack --config webpack.config.js",
    "webpack:build:prod": "webpack --config webpack.prod.config.js",
    "webpack:watch": "webpack --config webpack.config.js --watch",
    "bundle": "npm run webpack:build:prod",
    "bundle:dev": "npm run webpack:build",
    "dev": "node dev.js",
    "dev:rhino": "babel src --extensions \".ts,.tsx\" --out-dir dist --watch --config-file ./babel.config.rhino.js --verbose",
    "dev:simple": "babel src --extensions \".ts,.tsx\" --out-dir dist --watch --verbose",
    "demo": "node demo-watch.js",
    "clean": "rm -rf dist",
    "start": "node dist/main.js",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@sm003/autojs6-dts": "^2.1.3"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.0",
    "@babel/core": "^7.28.0",
    "@babel/plugin-transform-arrow-functions": "^7.27.1",
    "@babel/plugin-transform-block-scoping": "^7.28.0",
    "@babel/plugin-transform-class-properties": "^7.25.9",
    "@babel/plugin-transform-classes": "^7.28.0",
    "@babel/plugin-transform-computed-properties": "^7.27.1",
    "@babel/plugin-transform-destructuring": "^7.28.0",
    "@babel/plugin-transform-for-of": "^7.27.1",
    "@babel/plugin-transform-object-rest-spread": "^7.25.9",
    "@babel/plugin-transform-parameters": "^7.27.7",
    "@babel/plugin-transform-shorthand-properties": "^7.27.1",
    "@babel/plugin-transform-spread": "^7.27.1",
    "@babel/plugin-transform-template-literals": "^7.27.1",
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-typescript": "^7.27.1",
    "ts-loader": "^9.5.2",
    "typescript": "^5.8.3",
    "webpack": "^5.99.9",
    "webpack-cli": "^6.0.1"
  }
}
